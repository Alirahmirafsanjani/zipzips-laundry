# =============================================================================
# Environment variables — FRONTEND
# =============================================================================
# Salin file ini menjadi `.env` lalu isi. JANGAN commit `.env` ke git.
#   cp .env.example .env
# =============================================================================

# URL API backend — HANYA origin, TANPA /api di akhir.
# Semua path di frontend sudah diawali "/api" (mis. "/api/orders"), sehingga
# menaruh "/api" di sini akan menghasilkan "/api/api/orders" (semua 404).
# - Dev  : backend jalan di host yang sama, port 4000.
# - Prod : URL dari Render web service, contoh https://zipzips-api.onrender.com
#   Catatan: Render Free bisa "sleep", jadi request pertama bisa lambat.
VITE_API_URL="http://localhost:4000"

# Nama toko yang tampil di header & struk (bisa diubah lewat menu Pengaturan).
VITE_STORE_NAME="ZIP-ZIPS LAUNDRI"
