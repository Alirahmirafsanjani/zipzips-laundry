# =============================================================================
# Environment variables — BACKEND
# =============================================================================
# Salin file ini menjadi `.env` lalu isi. JANGAN commit `.env` ke git.
#   cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Database -----------------------------------------------------------------
# WAJIB memakai SESSION pooler (port 5432), BUKAN transaction pooler (6543).
# Prisma Migrate dan $transaction interaktif butuh session state + prepared
# statement, sehingga transaction mode akan gagal.
#
# Contoh Supabase (sesuaikan project ref):
#   postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=20
#
# Contoh PostgreSQL lokal:
#   postgresql://postgres:postgres@localhost:5432/zipzips?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zipzips?schema=public"

# --- Auth ---------------------------------------------------------------------
# WAJIB diganti di produksi. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="GANTI_DENGAN_RANDOM_64_KARAKTER_MINIMAL"
JWT_EXPIRES_IN="12h"

# --- CORS ---------------------------------------------------------------------
# Origin frontend yang diizinkan, dipisah koma. Kosongkan = izinkan semua (dev).
CORS_ORIGIN="http://localhost:5173"

# --- Rate limit ---------------------------------------------------------------
# Jumlah request login per 15 menit per IP.
LOGIN_RATE_LIMIT=10

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
